{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "builds": [
    { "src": "site/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/", "dest": "/site/index.html" },
    { "src": "/(es|legal|es/legal)/?", "dest": "/site/$1/index.html" },
    { "src": "/(.*)", "dest": "/site/$1" }
  ]
}
